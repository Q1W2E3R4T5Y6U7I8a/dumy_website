{
  "version": 2,
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },

    {
      "src": "/background_music.mp3",
      "headers": {
        "Content-Type": "audio/mpeg"
      }
    },
    
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

    
